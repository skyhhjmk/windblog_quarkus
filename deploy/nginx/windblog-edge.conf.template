# Render this file with the deployment platform's envsubst/template mechanism.
# The only public origin should be the fixed edge/CDN address. Do not proxy the
# database, Redis, RabbitMQ, Elasticsearch or Kibana ports through this file.

limit_req_zone $binary_remote_addr zone=windblog_public:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=windblog_connections:10m;

upstream windblog_quarkus {
    server ${WINDBLOG_APP_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    server_name ${WINDBLOG_PUBLIC_HOST};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${WINDBLOG_PUBLIC_HOST};

    ssl_certificate ${WINDBLOG_TLS_CERTIFICATE};
    ssl_certificate_key ${WINDBLOG_TLS_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:windblog_tls:10m;

    # Keep the public proxy cap aligned with WINDBLOG_EDGE_MAX_ROUTED_BODY_BYTES=10 MiB.
    client_max_body_size 10m;
    client_body_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Accept forwarded client IP only from the CDN/edge proxy network.
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    set_real_ip_from ${WINDBLOG_TRUSTED_PROXY_CIDR};

    location ^~ /q/ {
        allow ${WINDBLOG_MANAGEMENT_CIDR};
        deny all;
        proxy_pass http://windblog_quarkus;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_no_cache 1;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /api/admin/ {
        allow ${WINDBLOG_MANAGEMENT_CIDR};
        deny all;
        proxy_pass http://windblog_quarkus;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_no_cache 1;
    }

    location ^~ /api/media/download/ {
        limit_req zone=windblog_public burst=20 nodelay;
        limit_conn windblog_connections 10;
        proxy_pass http://windblog_quarkus;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_buffering off;
        proxy_no_cache 1;
        add_header Cache-Control "no-store" always;
    }

    location / {
        limit_req zone=windblog_public burst=60 nodelay;
        limit_conn windblog_connections 40;
        proxy_pass http://windblog_quarkus;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
