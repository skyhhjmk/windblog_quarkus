# 环境变量配置文件
# 复制此文件为 .env 并根据实际情况修改
# 推荐直接执行 ./admin.sh env-generate 自动生成强随机密钥，再执行 ./admin.sh env-check 检查配置

# 基础服务凭证与宿主机端口（示例值仅用于本地开发，生产必须替换）
WINDBLOG_SITE_PUBLIC_URL=https://your-domain.example
# WindBlog 主镜像从 Docker Hub 拉取；可按需改为固定版本或 digest
WINDBLOG_IMAGE=docker.io/hhjmk/windblog_quarkus:latest-native
WINDBLOG_PULL_POLICY=always
# Codex Creator is also published as a native private GHCR image.
CODEX_CREATOR_IMAGE=ghcr.io/skyhhjmk/codex-creator:latest-native
CODEX_CREATOR_PULL_POLICY=always
# One HMAC value is injected into both WindBlog and Codex Creator by Compose.
# Generate with ./admin.sh env-generate or: openssl rand -hex 32
CODEX_CREATOR_INTERNAL_SHARED_SECRET=replace_with_generated_codex_creator_shared_secret
# Encrypts only the private keys entered in AI Test Server management.
CODEX_CREATOR_TEST_SERVER_ENCRYPTION_SECRET=replace_with_a_separate_long_random_secret
# Optional child-to-WindBlog endpoint override; the shared secret defaults to
# CODEX_CREATOR_INTERNAL_SHARED_SECRET and should normally not be duplicated.
# CODEX_CREATOR_WINDBLOG_ENDPOINT=http://windblog:8080
# CODEX_CREATOR_WINDBLOG_MAX_IMAGE_BYTES=8388608
# Article generation is quality-first by default: high reasoning, one automatic
# quality repair, and deterministic depth/source gates. Tune only against real samples.
CODEX_CREATOR_PROMPT_VERSION=2
CODEX_CREATOR_ARTICLE_REASONING_EFFORT=high
CODEX_CREATOR_TOPIC_REASONING_EFFORT=medium
CODEX_CREATOR_ARTICLE_MAX_QUALITY_ATTEMPTS=2
CODEX_CREATOR_ARTICLE_MIN_CJK_CHARACTERS=1200
CODEX_CREATOR_ARTICLE_MIN_WORDS=900
CODEX_CREATOR_ARTICLE_MIN_SOURCES=2
# Set exactly one when CODEX_APP_SERVER_ENABLED=true. Keep credentials out of Git.
# OPENAI_API_KEY=replace-with-openai-api-key
# CODEX_ACCESS_TOKEN=replace-with-codex-access-token
WINDBLOG_HOST_PORT=8080
WINDBLOG_GRPC_HOST_PORT=9000
# WESP v1: a home node sets PEER_URL to the public primary; the public primary
# may leave it empty because home/edge nodes pull its operation log.
WINDBLOG_WESP_ENABLED=true
WINDBLOG_WESP_PEER_URL=
WINDBLOG_WESP_AUTH_TOKEN=replace_with_a_long_random_shared_token
# 必须在公网主与家庭/边缘节点安全预置相同的随机共享 token，不能留空
WINDBLOG_WESP_TENANT_ID=default
WINDBLOG_WESP_DATASET_ID=public
WINDBLOG_WESP_CONFIG_FILE=/deployments/wesp-config/wesp-config.json
WINDBLOG_WESP_MAX_EGRESS_BYTES_PER_MINUTE=0
# 管理脚本面向生产 native 镜像；生产必须使用 prod 并配置 HTTPS/TLS
QUARKUS_PROFILE=prod
# 持久化目录根路径；默认就是当前 Compose 项目目录，可改为绝对路径
WINDBLOG_DATA_DIR=.
# admin.sh 自动创建挂载目录时使用的权限；容器开发环境默认需要可写目录
WINDBLOG_DATA_DIR_MODE=0777
# gRPC mTLS 证书目录；admin.sh 会在缺少证书时生成本地开发证书
WINDBLOG_CERT_DIR=./certs
# 证书目录和私钥文件权限
WINDBLOG_CERT_DIR_MODE=0700
WINDBLOG_PRIVATE_FILE_MODE=0600
# 本地 truststore 密码由 ./admin.sh env-generate 生成；生产部署必须替换为独立强密码
GRPC_SERVER_TRUST_STORE_PASSWORD=replace_with_generated_truststore_password
GRPC_SERVER_PLAINTEXT=false
GRPC_SERVER_CLIENT_AUTH=required
GRPC_CLIENT_ALLOW_PLAINTEXT_FALLBACK=false
# 主 Compose/native 容器内的证书绝对路径；不要写宿主机路径
GRPC_SERVER_CERTIFICATE=/deployments/certs/ca/server.crt
GRPC_SERVER_KEY=/deployments/certs/ca/server.key
GRPC_SERVER_TRUST_STORE=/deployments/certs/ca/truststore.p12
GRPC_CLIENT_CA_CERTIFICATE=/deployments/certs/ca/ca.crt
GRPC_CLIENT_CERTIFICATE=/deployments/certs/ca/client.crt
GRPC_CLIENT_KEY=/deployments/certs/ca/client.key
# 只为已发布、公开且免费的文章生成 AMP；关闭后 AMP 路由返回 404
WIND_BLOG_AMP_ENABLED=true
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_USER=windblog
POSTGRES_DB=windblog
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# WindBlog/Codex Creator migrations require pgvector. Existing volumes must be backed up
# and migrated before changing the image; do not switch an unverified volume in place.
POSTGRES_IMAGE=pgvector/pgvector:pg18
# 默认只允许本机访问；如需局域网访问请改为明确内网地址并配置防火墙
WINDBLOG_HOST_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_PASSWORD=replace_with_local_redis_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_HOST_PORT=6379
RABBITMQ_DEFAULT_USER=windblog
RABBITMQ_DEFAULT_PASS=replace_with_local_rabbitmq_password
RABBITMQ_USERNAME=windblog
RABBITMQ_PASSWORD=replace_with_local_rabbitmq_password
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
ELASTICSEARCH_HOST_PORT=9200
KIBANA_HOST_PORT=5601
# 备份加密公钥指纹或邮箱；backup-windblog.ps1 拒绝未加密备份
WINDBLOG_BACKUP_GPG_RECIPIENT=replace_with_backup_gpg_recipient

# 生产启动默认安全配置必须拒绝；开发环境可使用本地默认值
SECURITY_FAIL_ON_DEFAULT_SECRETS_IN_PROD=true
# 默认关闭。首次生产启动且数据库没有活跃 SUPER_ADMIN 时可临时设为 true；
# 已有 SUPER_ADMIN 时会自动跳过，不会覆盖或提升普通用户。
ADMIN_INIT_ENABLED=false
COOKIE_SECURE=true
CORS_ORIGINS=https://your-domain.example
SECURITY_HEADERS_HSTS_ENABLED=true
SECURITY_HEADERS_CSP_ENFORCE=true

# 边缘回源写请求体上限，避免公网边缘入口把大请求一次性读入内存
WINDBLOG_EDGE_MAX_ROUTED_BODY_BYTES=10485760

# 异步任务保护：每轮最多领取的任务数与数据库租约；长任务不得无限占用 worker
WINDBLOG_OUTBOX_MAX_EVENTS_PER_CYCLE=100
WINDBLOG_OUTBOX_LEASE_DURATION=15M
WINDBLOG_OUTBOX_MAX_PENDING_EVENTS=100000
WINDBLOG_OUTBOX_RETENTION_DAYS=14
WINDBLOG_MAIL_MAX_DELIVERIES_PER_CYCLE=100
WINDBLOG_MAIL_DELIVERY_LEASE_DURATION=5M
WINDBLOG_MAIL_MAX_PENDING_DELIVERIES=100000
WINDBLOG_MAIL_DELIVERY_RETENTION_DAYS=90
WINDBLOG_MAIL_SMTP_CONNECT_TIMEOUT=10S
WINDBLOG_MAIL_SMTP_READ_TIMEOUT=30S
WINDBLOG_MAIL_SMTP_WRITE_TIMEOUT=30S

CLAMAV_HOST_PORT=3310
# ClamAV 默认只绑定主节点本机；不要复用对外管理服务的绑定地址
CLAMAV_HOST_BIND_IP=127.0.0.1

# 主节点媒体病毒扫描；生产必须启用并连接可用的 ClamAV clamd 服务
WIND_BLOG_MEDIA_VIRUS_SCAN_ENABLED=true
WIND_BLOG_MEDIA_VIRUS_SCAN_REQUIRED=true
WIND_BLOG_MEDIA_VIRUS_SCAN_HOST=127.0.0.1
WIND_BLOG_MEDIA_VIRUS_SCAN_PORT=3310
WIND_BLOG_MEDIA_VIRUS_SCAN_TIMEOUT=30S
WIND_BLOG_MEDIA_VIRUS_SCAN_AUTO_DETECT=true
WIND_BLOG_MEDIA_VIRUS_SCAN_AUTO_DETECT_HOSTS=clamav,127.0.0.1,host.docker.internal

# CSP 外部内容域和 API 域，多个 HTTPS origin 用逗号分隔；留空表示仅同源
SECURITY_HEADERS_CSP_IMG_SOURCES=none
SECURITY_HEADERS_CSP_CONNECT_SOURCES=none
SECURITY_HEADERS_CSP_TRUSTED_TYPES_ENABLED=true

# Elasticsearch 配置
# Elasticsearch 超级用户密码
ELASTIC_PASSWORD=replace_with_elasticsearch_password

# WindBlog 应用安全密钥；./admin.sh env-generate 会自动生成 64 位十六进制随机值
ADMIN_INIT_PASSWORD=replace_with_generated_admin_password
ADMIN_JWT_SECRET=replace_with_generated_admin_jwt_secret
USER_JWT_SECRET=replace_with_generated_user_jwt_secret
SECURITY_EVENT_HASH_SECRET=replace_with_generated_event_hash_secret

# Kibana 配置
# Kibana 加密密钥（用于加密 saved objects、session 等敏感数据）
# 必须是 32 字节的字符串（256 位）
KIBANA_ENCRYPTION_KEY=replace_with_kibana_encryption_key

# Kibana 报表加密密钥（用于加密报表数据）
# 必须是 32 字节的字符串（256 位）
KIBANA_REPORTING_KEY=replace_with_kibana_reporting_key

# Kibana 服务账户令牌（用于 Kibana 连接 Elasticsearch）
# 使用以下命令生成：curl -X POST -u elastic:<password> http://localhost:9200/_security/service/elastic/kibana/credential/token/kibana-token
KIBANA_SERVICE_ACCOUNT_TOKEN=replace_with_kibana_service_account_token

# Elasticsearch 连接配置（应用使用）
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace_with_elasticsearch_password
ELASTICSEARCH_SSL_VERIFY=full

# SSL 配置（开发环境也保持证书校验；仅在显式本地调试时临时覆盖）
ELASTICSEARCH_SSL_TRUST_ALL=false

# 环境标识
ENVIRONMENT=development

# Filebeat 配置
FILEBEAT_LOG_LEVEL=info
FILEBEAT_BATCH_SIZE=100
FILEBEAT_FLUSH_INTERVAL=5s
