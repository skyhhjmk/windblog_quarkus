# =========================================================================
# WindBlog 边缘节点环境变量模板 (Example)
# =========================================================================

# --- 边缘节点基础配置 ---
EDGE_NODE_ID=edge-node-identifier
EDGE_NODE_REGION=your-region-name
EDGE_HOST_BIND_IP=0.0.0.0

# 外部访问端口（用户浏览器访问）
EDGE_APP_HTTP_PORT=8081

# 兼容旧 gRPC 端口（WESP 模式不建立此同步连接；可保留用于迁移回滚）
EDGE_GRPC_PORT=9001
# 默认仅绑定回环地址；只有回滚到旧 gRPC 模式时才改为受防火墙保护的公网地址
EDGE_GRPC_BIND_IP=127.0.0.1

# --- WESP v1 主动 HTTPS 同步配置 ---
WINDBLOG_NODE_ROLE=edge
WINDBLOG_WESP_ENABLED=true
# 公网主 P 的 HTTPS 地址；家庭/边缘节点只主动访问此地址
WINDBLOG_WESP_PEER_URL=https://public.example.com
WINDBLOG_WESP_AUTH_TOKEN=set_a_long_random_shared_token
# 可选：容器内连接同一 Podman 网络中的本地目标；生产通常留空
WINDBLOG_WESP_LOCAL_TARGET_ALIAS=
WINDBLOG_WESP_LOCAL_TARGET_PORT=
# 可选：主节点自身使用回环发布地址时，给目标节点使用的同网别名
WINDBLOG_WESP_LOCAL_PEER_ALIAS=
WINDBLOG_WESP_TENANT_ID=default
WINDBLOG_WESP_DATASET_ID=public
WINDBLOG_WESP_CONFIG_FILE=/work/wesp-config/wesp-config.json
WINDBLOG_WESP_BLOCK_STORE=/work/wesp-blocks
WINDBLOG_WESP_MAX_EGRESS_BYTES_PER_MINUTE=0
# 同一节点重装时建议显式更换 incarnation，避免旧序号被误重放
WINDBLOG_WESP_INCARNATION=

# --- 旧 gRPC 主节点连接配置（仅回滚时使用） ---
MAIN_NODE_GRPC_HOST=127.0.0.1
MAIN_NODE_GRPC_PORT=9000

# --- 边缘节点数据库配置 (PostgreSQL) ---
EDGE_DB_USER=windblog_edge
EDGE_DB_PASSWORD=set_a_secure_password
EDGE_DB_NAME=windblog_edge
# 轻量边缘节点不需要 pgvector；仅使用 Alpine PostgreSQL，且不映射数据库端口
EDGE_DB_IMAGE=postgres:18-alpine

# --- 边缘节点缓存配置 (Redis) ---
EDGE_REDIS_PASSWORD=set_a_secure_redis_password

# --- 轻量运行时 ---
# 不部署 RabbitMQ、Elasticsearch、Codex Creator 或 ClamAV
WINDBLOG_EDGE_LIGHTWEIGHT=true
WINDBLOG_OUTBOX_ENABLED=false
WINDBLOG_CODEX_CREATOR_EVENTS_ENABLED=false
WIND_BLOG_MEDIA_VIRUS_SCAN_ENABLED=false
WIND_BLOG_MEDIA_VIRUS_SCAN_REQUIRED=false
WINDBLOG_STORAGE_METRICS_ENABLED=false
WINDBLOG_LOG_COMPRESSION_ENABLED=false
QUARKUS_LOG_FILE_ENABLED=false

# --- 内部连接 URL ---
EDGE_DATASOURCE_URL=jdbc:postgresql://edge-db:5432/windblog_edge
EDGE_REDIS_URL=redis://edge-redis:6379

# --- gRPC mTLS 证书路径 ---
EDGE_CERT_PATH=certs/ca/server.crt
EDGE_KEY_PATH=certs/ca/server.key
CA_CERT_PATH=certs/ca/ca.crt
EDGE_BACKUP_CERT_PATH=certs/ca/backup.crt
EDGE_BACKUP_KEY_PATH=certs/ca/backup.key
GRPC_CLIENT_CA_CERTIFICATE=certs/ca/ca.crt
GRPC_CLIENT_CERTIFICATE=certs/ca/server.crt
GRPC_CLIENT_KEY=certs/ca/server.key
