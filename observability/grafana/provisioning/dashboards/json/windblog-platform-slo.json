{
  "uid": "windblog-platform-slo",
  "title": "WindBlog 平台 SLO 总览",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "tags": ["windblog", "slo", "opentelemetry"],
  "templating": {"list": [{"name": "service", "type": "query", "datasource": {"uid": "prometheus"}, "query": "label_values(target_info, service_name)", "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Collector 指标导出成功率", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 7}, "targets": [{"expr": "windblog:collector_export_success:ratio", "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}, "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.99}]}}}},
    {"id": 2, "type": "stat", "title": "Prometheus Targets UP", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 7}, "targets": [{"expr": "sum(up)", "refId": "A"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}},
    {"id": 3, "type": "timeseries", "title": "HTTP 请求率", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 7}, "targets": [{"expr": "sum(rate(http_server_requests_milliseconds_count{service_name=~\"$service\"}[5m])) by (service_name)", "legendFormat": "{{service_name}}", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "HTTP 5xx 错误率", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(http_server_requests_milliseconds_count{status=~\"5..\",service_name=~\"$service\"}[5m])) by (service_name)", "legendFormat": "{{service_name}}", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "HTTP P95 延迟", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 12, "y": 7, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_milliseconds_bucket{service_name=~\"$service\"}[5m])) by (le, service_name))", "legendFormat": "{{service_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ms"}}},
    {"id": 6, "type": "timeseries", "title": "JVM 堆内存", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 0, "y": 15, "w": 8, "h": 8}, "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\",service_name=~\"$service\"}) by (service_name)", "legendFormat": "{{service_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 7, "type": "timeseries", "title": "PostgreSQL 连接", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 8, "y": 15, "w": 8, "h": 8}, "targets": [{"expr": "postgresql_backends", "refId": "A"}]},
    {"id": 8, "type": "timeseries", "title": "Redis 内存", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 16, "y": 15, "w": 8, "h": 8}, "targets": [{"expr": "redis_memory_used_bytes", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 9, "type": "timeseries", "title": "RabbitMQ 队列消息", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 0, "y": 23, "w": 12, "h": 8}, "targets": [{"expr": "sum(rabbitmq_message_current) by (rabbitmq_queue_name, state)", "legendFormat": "{{rabbitmq_queue_name}} / {{state}}", "refId": "A"}]},
    {"id": 10, "type": "timeseries", "title": "JVM GC 暂停占比", "datasource": {"uid": "prometheus"}, "gridPos": {"x": 12, "y": 23, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(jvm_gc_collections_elapsed_milliseconds_total{service_name=~\"$service\"}[5m])) by (service_name) / 1000", "legendFormat": "{{service_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}}
  ]
}
