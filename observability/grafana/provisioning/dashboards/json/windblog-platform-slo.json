{
  "uid": "windblog-platform-slo",
  "title": "WindBlog 平台全景可观测性仪表盘",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "tags": [
    "windblog",
    "slo",
    "opentelemetry",
    "full-stack",
    "elasticsearch",
    "database",
    "redis"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "服务名",
        "type": "query",
        "datasource": {
          "uid": "prometheus"
        },
        "query": "label_values(target_info, service_name)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "interval",
        "label": "聚合周期",
        "type": "interval",
        "datasource": {
          "uid": "prometheus"
        },
        "query": "30s,1m,2m,5m,10m",
        "current": {
          "text": "1m",
          "value": "1m"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "🌟 平台核心健康度与 SLO 概览 (Platform Health & SLO)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Collector 指标导出成功率",
      "description": "OTel Collector 指标导出成功率与健康度",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "expr": "windblog:collector_export_success:ratio",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prometheus 活跃监控目标 (UP)",
      "description": "监控采集端点在线数量",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(up)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP 总吞吐率 (QPS)",
      "description": "WindBlog 当前 HTTP 请求吞吐量",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_milliseconds_count{service_name=~\"$service\"}[$interval])) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP 5xx 错误率",
      "description": "服务端异常响应占比",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_milliseconds_count{status=~\"5..\",service_name=~\"$service\"}[$interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_milliseconds_count{service_name=~\"$service\"}[$interval])), 0.001)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "HTTP P95 响应延迟",
      "description": "95% 请求的响应时间上限",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_milliseconds_bucket{service_name=~\"$service\"}[$interval])) by (le))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 200
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          }
        }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "🌐 HTTP 流量明细与分位数延迟 (HTTP Traffic & Latencies)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP 请求吞吐 (按状态码分布)",
      "description": "HTTP 请求状态码吞吐面积图",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_milliseconds_count{status=~\"2..\",service_name=~\"$service\"}[$interval])) or vector(0)",
          "legendFormat": "2xx 成功",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_milliseconds_count{status=~\"3..\",service_name=~\"$service\"}[$interval])) or vector(0)",
          "legendFormat": "3xx 重定向",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_milliseconds_count{status=~\"4..\",service_name=~\"$service\"}[$interval])) or vector(0)",
          "legendFormat": "4xx 客户端错误",
          "refId": "C"
        },
        {
          "expr": "sum(rate(http_server_requests_milliseconds_count{status=~\"5..\",service_name=~\"$service\"}[$interval])) or vector(0)",
          "legendFormat": "5xx 服务端错误",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 40
          }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP 响应延迟分位数 (P50 / P90 / P95 / P99)",
      "description": "请求响应延迟各分位数分布趋势",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_milliseconds_bucket{service_name=~\"$service\"}[$interval])) by (le))",
          "legendFormat": "P50 延迟",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_server_requests_milliseconds_bucket{service_name=~\"$service\"}[$interval])) by (le))",
          "legendFormat": "P90 延迟",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_milliseconds_bucket{service_name=~\"$service\"}[$interval])) by (le))",
          "legendFormat": "P95 延迟",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_milliseconds_bucket{service_name=~\"$service\"}[$interval])) by (le))",
          "legendFormat": "P99 延迟",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Top 请求路由吞吐与分布 (按 URI)",
      "description": "访问量最高的 8 个接口路由",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(8, sum(rate(http_server_requests_milliseconds_count{service_name=~\"$service\"}[$interval])) by (uri))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 14,
      "type": "piechart",
      "title": "HTTP 状态码占比分布",
      "description": "各状态码总体比例",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_milliseconds_count{service_name=~\"$service\"}[$interval])) by (status)",
          "legendFormat": "Status {{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "🗄️ PostgreSQL 与 Agroal 数据库连接池 (Database & Connection Pools)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Agroal 数据库连接池状态 (活跃 / 可用 / 上限 / 排队)",
      "description": "WindBlog 数据源连接池使用情况，监测连接泄漏与阻塞",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(agroal_active_count{service_name=~\"$service\"}) or sum(postgresql_backends)",
          "legendFormat": "活跃连接 (Active)",
          "refId": "A"
        },
        {
          "expr": "sum(agroal_available_count{service_name=~\"$service\"}) or vector(0)",
          "legendFormat": "空闲可用 (Available)",
          "refId": "B"
        },
        {
          "expr": "sum(agroal_max_count{service_name=~\"$service\"}) or vector(32)",
          "legendFormat": "池上限 (Max)",
          "refId": "C"
        },
        {
          "expr": "sum(agroal_awaiting_count{service_name=~\"$service\"}) or vector(0)",
          "legendFormat": "等待排队 (Awaiting)",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Agroal 连接池流转速率与获取耗时",
      "description": "连接创建/销毁速率与线程获取连接的平均耗时",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(agroal_creation_count_total{service_name=~\"$service\"}[$interval])) or vector(0)",
          "legendFormat": "连接创建速率",
          "refId": "A"
        },
        {
          "expr": "sum(rate(agroal_destroy_count_total{service_name=~\"$service\"}[$interval])) or vector(0)",
          "legendFormat": "连接销毁速率",
          "refId": "B"
        },
        {
          "expr": "((sum(rate(agroal_acquire_duration_seconds_sum{service_name=~\"$service\"}[$interval])) / clamp_min(sum(rate(agroal_acquire_duration_seconds_count{service_name=~\"$service\"}[$interval])), 0.001)) * 1000) or vector(0)",
          "legendFormat": "平均获取耗时 (ms)",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "PostgreSQL 后端连接与死锁检测",
      "description": "PostgreSQL 服务端连接数与死锁检测",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "postgresql_backends or vector(0)",
          "legendFormat": "后端连接数 (Backends)",
          "refId": "A"
        },
        {
          "expr": "rate(postgresql_deadlocks[$interval]) or vector(0)",
          "legendFormat": "死锁速率 (Deadlocks/s)",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "PostgreSQL 事务吞吐与缓冲区命中率",
      "description": "事务提交/回滚速率与共享缓冲区读命中比例",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(postgresql_commits[$interval])) or sum(rate(postgresql_commits_total[$interval])) or vector(0)",
          "legendFormat": "提交速率 (Commits/s)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(postgresql_rollbacks[$interval])) or sum(rate(postgresql_rollbacks_total[$interval])) or vector(0)",
          "legendFormat": "回滚速率 (Rollbacks/s)",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(postgresql_blocks_hit[$interval])) / clamp_min(sum(rate(postgresql_blocks_hit[$interval])) + sum(rate(postgresql_blocks_read[$interval])), 0.001)) or vector(1)",
          "legendFormat": "缓冲区命中率",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "PostgreSQL 行操作 (DML) 速率与数据库大小",
      "description": "数据行读取、插入、更新、删除操作吞吐",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(postgresql_rows{state=\"fetched\"}[$interval])) or vector(0)",
          "legendFormat": "Rows Fetched",
          "refId": "A"
        },
        {
          "expr": "sum(rate(postgresql_rows{state=\"inserted\"}[$interval])) or vector(0)",
          "legendFormat": "Rows Inserted",
          "refId": "B"
        },
        {
          "expr": "sum(rate(postgresql_rows{state=\"updated\"}[$interval])) or vector(0)",
          "legendFormat": "Rows Updated",
          "refId": "C"
        },
        {
          "expr": "sum(rate(postgresql_rows{state=\"deleted\"}[$interval])) or vector(0)",
          "legendFormat": "Rows Deleted",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "🔍 Elasticsearch 搜索引擎与集群状态 (Elasticsearch Cluster & Search)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 31,
      "type": "stat",
      "title": "ES 集群状态 (Health Status)",
      "description": "Elasticsearch 集群健康状态：Green=健康，Yellow=副本待分配(单节点)，Red=分片丢失",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "elasticsearch_cluster_status or vector(1)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "RED 异常",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "YELLOW 正常(单节点)",
                  "color": "#EAB839"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "GREEN 极佳",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "ES 分片与节点统计",
      "description": "活跃分片、未分配分片及集群节点总数",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 42,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(elasticsearch_cluster_shards{shard_state=\"active\"}) or vector(0)",
          "legendFormat": "活跃分片",
          "refId": "A"
        },
        {
          "expr": "sum(elasticsearch_cluster_shards{shard_state=\"unassigned\"}) or vector(0)",
          "legendFormat": "未分配分片",
          "refId": "B"
        },
        {
          "expr": "sum(elasticsearch_cluster_nodes) or vector(1)",
          "legendFormat": "节点总数",
          "refId": "C"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "ES 索引文档总数",
      "description": "Elasticsearch 中存储的全部索引文档总数",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(elasticsearch_node_documents{document_state=\"active\"}) or sum(elasticsearch_node_documents) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "id": 34,
      "type": "stat",
      "title": "ES 索引分片占用存储空间",
      "description": "分片占用磁盘大小与可用空间",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 42,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
