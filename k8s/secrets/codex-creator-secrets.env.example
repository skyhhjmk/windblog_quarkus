# Copy this file to codex-creator-secrets.env, replace every value with a
# separately generated secret, and create the Kubernetes Secret with:
# kubectl create secret generic codex-creator-secrets \
#   --from-env-file=k8s/secrets/codex-creator-secrets.env \
#   --dry-run=client -o yaml | kubectl apply -f -
#
# This file is intentionally not included by kustomization.yaml. Never commit
# the copied file or the generated Secret manifest.
admin-token=replace-with-a-long-random-token
internal-shared-secret=replace-with-a-long-random-secret
mcp-bearer-token=replace-with-a-long-random-token
# Set exactly one of the following for headless Codex app-server automation.
# The deployment accepts either key; authentication happens when the container starts.
# openai-api-key=replace-with-openai-api-key
# codex-access-token=replace-with-codex-access-token
