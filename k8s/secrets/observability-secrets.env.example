# Create the real secret outside Git:
# kubectl create secret generic observability-secrets --from-env-file=.env.observability
POSTGRES_USER=windblog
POSTGRES_PASSWORD=replace_with_postgresql_password
REDIS_PASSWORD=replace_with_redis_password
RABBITMQ_USERNAME=windblog
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=replace_with_elasticsearch_password
OTEL_DEPLOYMENT_ENVIRONMENT=production
GRAFANA_JWT_SECRET=replace_with_32_byte_random_secret
# JSON Web Key Set matching GRAFANA_JWT_SECRET. For an ASCII secret S use the
# base64url-without-padding value of S as k: {"keys":[{"kty":"oct","kid":"windblog","alg":"HS256","k":"..."}]}.
GRAFANA_JWT_JWK_SET={"keys":[{"kty":"oct","kid":"windblog","alg":"HS256","k":"replace_with_base64url_secret"}]}
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password
GRAFANA_ROOT_URL=https://your-domain.example/observability/grafana/
